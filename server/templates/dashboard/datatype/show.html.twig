{# templates/dashboard/datatype/show.html.twig #}
{% extends 'dashboard/dashboard_base.html.twig' %}

{% block content %}
    <div class="section">
        {# Header with name and actions #}
        <div class="container mb-6">
            <div class="level mb-4">
                <div class="level-left">
                    <div class="level-item">
                        <h1 class="title is-1" style="color: #fff; margin: 0;">{{ datatype.name }}</h1>
                    </div>
                </div>
                <div class="level-right">
                    <div class="level-item">
                        <a href="{{ path('app_dashboard_datatype') }}"
                           class="button is-outlined"
                           style="border-color: var(--bulma-primary); color: var(--bulma-primary);">
                            Back to Data types
                        </a>
                    </div>
                    <div class="level-item">
                        <a href="{{ path('app_dashboard_datatype_form', { id: datatype.id }) }}"
                           class="button"
                           style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">
                            Edit Data type
                        </a>
                    </div>
                    <div class="level-item">
                        <form method="post"
                              action="{{ path('app_datatype_delete', { id: datatype.id }) }}"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this data type?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_datatype_' ~ datatype.id) }}">
                            <button class="button is-danger">
                                Delete Data type
                                <span class="icon is-small ml-1">
                                    <i class="fas fa-trash"></i>
                                </span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            {# Basic meta line (content / form type) #}
            <p class="subtitle is-family-code"
               style="background-color: #2a2a2a; color: var(--bulma-primary); padding: 0.5rem; border-radius: 4px; display: inline-block;">
                Content type: {{ datatype.contentType }} —
                Form type: {{ datatype.formType }}
            </p>
        </div>

        {# Stats #}
        <div class="container">
            <div class="columns mb-6">
                <div class="column is-4">
                    <div class="box"
                         style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                        <p class="heading" style="color: #888;">Ressources using this data type</p>
                        <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">
                            {{ datatype.ressources|length }}
                        </p>
                    </div>
                </div>
                <div class="column is-4">
                    <div class="box"
                         style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                        <p class="heading" style="color: #888;">Content type</p>
                        <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">
                            {{ datatype.contentType }}
                        </p>
                    </div>
                </div>
                <div class="column is-4">
                    <div class="box"
                         style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                        <p class="heading" style="color: #888;">Form type</p>
                        <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">
                            {{ datatype.formType }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {# Ressources section #}
        <div class="container mb-6" id="ressources">
            <div class="level mb-4">
                <div class="level-left">
                    <div class="level-item">
                        <h2 class="title is-3" style="color: #fff; margin: 0;">Ressources</h2>
                    </div>
                </div>
                <div class="level-right">
                    {# <div class="level-item">
                        <button disabled
                                class="button"
                                style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">
                            Attach Ressource
                        </button>
                    </div> #}
                </div>
            </div>

            {% if datatype.ressources is defined and datatype.ressources|length > 0 %}
                <div class="table-container has-radius">
                    <table class="table is-fullwidth"
                           style="background-color: #2a2a2a; color: #fff;">
                        <thead style="border-bottom: 2px solid var(--bulma-primary);">
                        <tr>
                            <th style="color: var(--bulma-primary);">Name</th>
                            <th style="color: var(--bulma-primary);">Game</th>
                            <th style="color: var(--bulma-primary);">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ressource in datatype.ressources %}
                            <tr style="border-bottom: 1px solid #3a3a3a;">
                                <td>{{ ressource.name }}</td>
                                <td>
                                    {% if ressource.game is not null %}
                                        {{ ressource.game.name }}
                                        <span class="is-size-7 has-text-grey">({{ ressource.game.slug }})</span>
                                    {% else %}
                                        <span class="has-text-grey">No game</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="control is-flex">
                                        <a href="{{ path('app_dashboard_ressource_show', { id: ressource.id }) }}"
                                           class="button is-small"
                                           style="background-color: #3a3a3a; color: var(--bulma-primary); border: 1px solid var(--bulma-primary); margin-right: 0.25rem;">
                                            View
                                        </a>
                                        <a href="{{ path('app_dashboard_ressource_form', { id: ressource.id }) }}"
                                           class="button is-small">
                                            Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="box"
                     style="background-color: #2a2a2a; text-align: center; padding: 2rem;">
                    <p style="color: #888;">No ressources are using this data type yet.</p>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .table tbody tr:hover {
            background-color: #3a3a3a;
        }

        .card:hover {
            border-color: var(--bulma-primary);
            box-shadow: 0 0 20px rgba(0, 209, 178, 0.2);
        }
    </style>
{% endblock %}
