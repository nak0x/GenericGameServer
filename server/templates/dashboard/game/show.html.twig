{% extends 'dashboard/dashboard_base.html.twig' %}

{% block content %}
<div class="section">
    <!-- Game header with name and slug -->
    <div class="container mb-6">
        <div class="level mb-4">
            <div class="level-left">
                <div class="level-item">
                    <h1 class="title is-1" style="color: #fff; margin: 0;">{{ game.name }}</h1>
                </div>
            </div>
            <div class="level-right">
                <div class="level-item">
                    <a href="{{ path('app_game_edit', {slug: game.slug}) }}" class="button" style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">Edit Game</a>
                </div>
                <div class="level-item">
                    <form method="post" action="{{ path('app_game_delete', { slug: game.slug }) }}" style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this game?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_game_' ~ game.id) }}">
                        <button class="button is-danger">
                            Delete Game
                            <span class="icon is-small ml-1">
                                <i class="fas fa-trash"></i>
                            </span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <p class="subtitle is-family-code" style="background-color: #2a2a2a; color: var(--bulma-primary); padding: 0.5rem; border-radius: 4px; display: inline-block;">{{ game.slug }}</p>
    </div>

    <!-- Game stats in columns -->
    <div class="columns mb-6">
        <div class="column is-4">
            <div class="box" style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                <p class="heading" style="color: #888;">Total Users</p>
                <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">{{ game.users|length }}</p>
            </div>
        </div>
        <div class="column is-4">
            <div class="box" style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                <p class="heading" style="color: #888;">Total Clients</p>
                <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">{{ game.clients|length }}</p>
            </div>
        </div>
        <div class="column is-4">
            <div class="box" style="background-color: #2a2a2a; border-left: 4px solid var(--bulma-primary);">
                <p class="heading" style="color: #888;">Total Resources</p>
                <p class="title" style="color: var(--bulma-primary); margin-top: 0.5rem;">{{ game.ressources|length }}</p>
            </div>
        </div>
    </div>

    <!-- Users section -->
    <div class="container mb-6">
        <div class="level mb-4">
            <div class="level-left">
                <div class="level-item">
                    <h2 class="title is-3" style="color: #fff; margin: 0;">Users & Admins</h2>
                </div>
            </div>
            <div class="level-right">
                <div class="level-item">
                    <a href="{{ path('app_game_user_new', {slug: game.slug})}}" class="button" style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">Add User</a>
                </div>
            </div>
        </div>

        {% if game.users is defined and game.users|length > 0 %}
            <div class="table-container has-radius">
                <table class="table is-fullwidth" style="background-color: #2a2a2a; color: #fff;">
                    <thead style="border-bottom: 2px solid var(--bulma-primary);">
                        <tr>
                            <th style="color: var(--bulma-primary);">Username</th>
                            <th style="color: var(--bulma-primary);">Role</th>
                            <th style="color: var(--bulma-primary);">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in game.users %}
                            <tr style="border-bottom: 1px solid #3a3a3a;">
                                <td>{{ user.username }}</td>
                                <td>
                                    {% for role in user.roles %}
                                    <span class="tag" style="background-color: var(--bulma-primary); color: #1a1a1a;">{{ role }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    <button class="button is-small" style="background-color: #3a3a3a; color: var(--bulma-primary); border: 1px solid var(--bulma-primary);" disabled>Remove</button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="box" style="background-color: #2a2a2a; text-align: center; padding: 2rem;">
                <p style="color: #888;">No users added to this game yet.</p>
            </div>
        {% endif %}
    </div>

    <!-- Clients section -->
    <div class="container mb-6" id="clients">
        <div class="level mb-4">
            <div class="level-left">
                <div class="level-item">
                    <h2 class="title is-3" style="color: #fff; margin: 0;">Clients</h2>
                </div>
            </div>
            <div class="level-right">
                <div class="level-item">
                    <button disabled class="button" style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">Add Client</buttond>
                </div>
            </div>
        </div>

        {% if game.clients is defined and game.clients|length > 0 %}
            <div class="columns is-multiline">
                {% for client in game.clients %}
                    <div class="column is-4">
                        <div class="card" style="background-color: #2a2a2a; border: 1px solid #3a3a3a;">
                            <div class="card-content">
                                <div class="media">
                                    <div class="media-content">
                                        <p class="title is-4" style="color: #fff;">{{ client.name }}</p>
                                        <p class="subtitle is-6 is-family-code" style="color: var(--bulma-primary); background-color: #1a1a1a; padding: 0.5rem; border-radius: 4px; margin-top: 0.5rem;">{{ client.provider.value }}</p>
                                    </div>
                                </div>
                                <div class="content" style="color: #ccc; margin-top: 1rem;">
                                    <small>Status: <span style="color: var(--bulma-primary);">Active</span></small>
                                </div>
                            </div>
                            <footer class="card-footer">
                                <button disabled class="card-footer-item button" style="color: var(--bulma-primary);">View</button>
                                <button disabled class="card-footer-item button" style="color: var(--bulma-primary);">Edit</button>
                                <button disabled class="card-footer-item button" style="color: #ff6b6b;">Delete</button>
                            </footer>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="box" style="background-color: #2a2a2a; text-align: center; padding: 2rem;">
                <p style="color: #888;">There is currently no client for your game. Please add one.</p>
            </div>
        {% endif %}
    </div>

    <!-- Resources section -->
    <div class="container mb-6" id="resources">
        <div class="level mb-4">
            <div class="level-left">
                <div class="level-item">
                    <h2 class="title is-3" style="color: #fff; margin: 0;">Resources</h2>
                </div>
            </div>
            <div class="level-right">
                <div class="level-item">
                    <a  href="{{ path('app_game_ressource_new', {slug: game.slug}) }}" class="button" style="background-color: var(--bulma-primary); color: #1a1a1a; border: none;">Add Resource</a>
                </div>
            </div>
        </div>

        {% if game.ressources is defined and game.ressources|length > 0 %}
            <div class="table-container">
                <table class="table is-fullwidth" style="background-color: #2a2a2a; color: #fff;">
                    <thead style="border-bottom: 2px solid var(--bulma-primary);">
                        <tr>
                            <th style="color: var(--bulma-primary);">Name</th>
                            <th style="color: var(--bulma-primary);">Type</th>
                            <th style="color: var(--bulma-primary);">Status</th>
                            <th style="color: var(--bulma-primary);">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ressource in game.ressources %}
                            <tr style="border-bottom: 1px solid #3a3a3a;">
                                <td>{{ ressource.name }}</td>
                                <td>
                                    {% for datatype in ressource.datatypes %}
                                    <span class="tag" style="background-color: #3a3a3a; color: var(--bulma-primary);">{{ datatype.name }} </span>
                                    {% endfor %}
                                </td>
                                <td><span class="tag" style="background-color: #28a745; color: #fff;">Active</span></td>
                                <td>
                                    <div class="control is-flex">
                                        <a href="{{ path('app_dashboard_ressource_edit', {id: ressource.id}) }}" class="button is-small" style="background-color: #3a3a3a; color: var(--bulma-primary); border: 1px solid var(--bulma-primary); margin-right: 0.25rem;">Edit</a>
                                        <form method="post" action="{{ path('app_ressource_delete', { id: ressource.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_ressource_' ~ ressource.id) }}">
                                            <button class="button is-small is-danger" type="submit">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="box" style="background-color: #2a2a2a; text-align: center; padding: 2rem;">
                <p style="color: #888;">No resources allocated to this game yet.</p>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: #3a3a3a;
    }

    .card:hover {
        border-color: var(--bulma-primary);
        box-shadow: 0 0 20px rgba(0, 209, 178, 0.2);
    }
</style>
{% endblock %}
